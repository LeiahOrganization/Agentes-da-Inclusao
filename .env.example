# ============================================================
# Agentes da Inclusao - copie este arquivo para .env e ajuste.
# O .env NAO vai para o Git.
# ============================================================

# --- Modelo de linguagem (endpoint compativel com OpenAI) ---
# Groq (gratuito, chave em console.groq.com/keys) - mesma chave do Olhar Acessivel:
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.6-27b
LLM_API_KEY=coloque-sua-chave-aqui
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4000
LLM_TIMEOUT=120

# --- Upload ---
MAX_UPLOAD_MB=10

# --- API ---
# Em producao, troque * pelos dominios reais separados por virgula.
CORS_ORIGINS=*
