{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "{main.py,config.py,orchestrator.py,session_store.py,agents/**,utils/**,src/**}"
    }
  }
}
